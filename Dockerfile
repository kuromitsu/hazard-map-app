# ---------------------------------------------------
# 1. ビルド用ステージ（ここでGoのコードをコンパイルします）
# ---------------------------------------------------
FROM golang:1.23-alpine AS builder

# 作業ディレクトリを作成
WORKDIR /app

# 依存関係ファイルを先にコピー（キャッシュ利用のため）
COPY go.mod go.sum ./
RUN go mod download

# ソースコードを全てコピー
COPY . .

# アプリケーションをビルド
# -o main : 出力ファイル名を main に指定
RUN go build -o main .


# ---------------------------------------------------
# 2. 実行用ステージ（完成したアプリだけを乗せる軽量な環境）
# ---------------------------------------------------
FROM alpine:latest

# 作業ディレクトリを作成
WORKDIR /app

# ビルド用ステージから、コンパイル済みのバイナリファイルだけをコピー
COPY --from=builder /app/main .

# 【重要】HTMLテンプレートもコピーしないと画面が表示されません
COPY --from=builder /app/templates ./templates

# Ginフレームワークを本番モード（高速・ログ抑制）に設定
ENV GIN_MODE=release

# ポート8080を開放することを明示
EXPOSE 8080

# アプリを実行
CMD ["./main"]